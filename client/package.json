{
  "name": "maktime-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:assets": "npx @capacitor/assets generate --android --ios --assetPath assets --iconBackgroundColor '#0B132B' --iconBackgroundColorDark '#05070F' --splashBackgroundColor '#0B132B' --splashBackgroundColorDark '#05070F' --logoSplashScale 0.23",
    "mobile:doctor": "npx cap doctor",
    "mobile:copy": "npm run build && npx cap copy",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:sync:prod": "CAP_ENV=production npm run mobile:sync && node scripts/strip-ios-push.js",
    "mobile:sync-prod": "npm run mobile:sync:prod",
    "mobile:sync:staging": "CAP_ENV=staging npm run mobile:sync && node scripts/strip-ios-push.js",
    "mobile:prepare:prod": "npm run mobile:assets && npm run mobile:sync:prod",
    "mobile:prepare:staging": "npm run mobile:assets && npm run mobile:sync:staging",
    "mobile:android:open": "npx cap open android",
    "mobile:ios:open": "npx cap open ios",
    "mobile:android:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:android:debug:staging": "CAP_ENV=staging npm run mobile:android:debug",
    "mobile:android:release": "npm run mobile:sync:prod && cd android && ./gradlew clean assembleRelease",
    "mobile:android:release:staging": "CAP_ENV=staging npm run mobile:android:release"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^28.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
